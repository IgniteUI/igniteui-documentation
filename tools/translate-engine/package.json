{
  "name": "translate-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project agnostic, structure preserving markdown/MDX translation pipeline. Each consuming project supplies its own config (field contract, ignore rules, path layout, glossary, provider).",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test": "tsx --test \"tests/*.test.ts\"",
    "test:watch": "tsx --test --watch \"tests/*.test.ts\"",
    "status": "tsx src/cli.ts status",
    "translate": "tsx src/cli.ts translate",
    "validate": "tsx src/cli.ts validate",
    "judge": "tsx src/cli.ts judge",
    "estimate-cost": "tsx scripts/estimate-cost.ts",
    "identity-check": "tsx scripts/identity-check.ts",
    "anchor-check": "tsx scripts/anchor-check.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "p-limit": "^7.3.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tinyglobby": "^0.2.17",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "github-slugger": "^2.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=24"
  }
}

---
/**
 * Head.astro — canonical, hreflang and JSON-LD for every documentation page
 *
 * Renders, inside the document `<head>`:
 *
 *   • `<link rel="canonical">` — the page's own clean URL (no `.html`), the
 *     same URL the sitemap lists.
 *   • `<link rel="alternate" hreflang>` — this page and the same page in the
 *     other language's docs (en ↔ ja), plus `x-default` → English. Only when the
 *     other language's sitemap lists the page (see src/lib/language-alternates.ts).
 *
 * and a single JSON-LD `<script type="application/ld+json">` block using a `@graph` array:
 *
 *   • TechArticle    – headline, description, canonical URL, language,
 *                       author and publisher of the page.
 *   • BreadcrumbList – breadcrumb trail derived from the sidebar tree.
 *
 * Usage: place this component inside the `head` slot of DocsLayout so the
 * block is injected into `<head>` alongside the standard meta tags.
 */
import { Schema } from 'astro-seo-schema';
import { sidebar as sidebarData, title as siteTitle, navLang } from 'virtual:docs-template/site-meta';
import { platform as platformKey } from 'virtual:docs-template/nav-html';
import { getBreadcrumb } from 'igniteui-astro-components/lib/sidebar/helpers';
import type { SidebarEntry } from 'igniteui-astro-components/lib/sidebar/types';
import {
  HREFLANG_BY_NAV_LANG,
  hreflangLinks,
  loadLanguageAlternates,
  pagePathFromSlug,
  pageUrl as urlFor,
} from '../../lib/language-alternates.ts';

export interface Props {
  title?: string | null;
  description?: string | null;
  currentSlug?: string;
}

const { title, description, currentSlug = '' } = Astro.props;

// The served URL. Astro.url ends in `.html` (build.format 'file'), which the
// server redirects to the clean path, so the URL is built from the site (which
// includes the base path) and the slug, the same way the sitemap builds it.
const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const pagePath = pagePathFromSlug(currentSlug);
const pageUrl = siteUrl ? urlFor(siteUrl, pagePath) : Astro.url.href.replace(/\.html$/, '');

// DOCS_BUILD_MODE is set by createDocsSite (src/integration.ts).
const buildMode = process.env.DOCS_BUILD_MODE ?? 'development';
const alternateLinks = hreflangLinks({
  pagePath,
  selfHreflang: HREFLANG_BY_NAV_LANG[navLang] ?? 'en',
  selfUrl: pageUrl,
  alternates: await loadLanguageAlternates(platformKey, navLang, buildMode),
});
const resolvedSidebar = sidebarData as SidebarEntry[];

// Map internal locale codes to BCP-47 language tags.
const langMap: Record<string, string> = { en: 'en', jp: 'ja', kr: 'ko' };
const inLanguage = langMap[navLang] ?? 'en';

// Build breadcrumb labels: [siteTitle, ...crumb labels]
const crumbLabels = currentSlug ? getBreadcrumb(resolvedSidebar, currentSlug) : [];
const allCrumbs = [siteTitle, ...crumbLabels];

// Only the last breadcrumb item (current page) has a resolvable URL.
// Intermediate items omit `item` since getBreadcrumb returns labels only.
const breadcrumbItems = allCrumbs.map((name, index) => ({
  '@type': 'ListItem' as const,
  position: index + 1,
  name,
  ...(index === allCrumbs.length - 1
    ? { item: { '@type': 'WebPage' as const, '@id': pageUrl } }
    : {}),
}));

const infragistics = {
  '@type': 'Organization' as const,
  name: 'Infragistics',
  url: 'https://www.infragistics.com',
};

const graph: Record<string, unknown>[] = [];

if (title) {
  graph.push({
    '@type': 'TechArticle',
    '@id': pageUrl,
    headline: title,
    ...(description ? { description } : {}),
    url: pageUrl,
    inLanguage,
    author: infragistics,
    publisher: {
      ...infragistics,
      logo: {
        '@type': 'ImageObject',
        url: 'https://www.infragistics.com/assets/favicon/favicon.ico',
      },
    },
  });
}

if (breadcrumbItems.length > 1) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems,
  });
}
---

<link rel="canonical" href={pageUrl} />
{alternateLinks.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
{graph.length > 0 && (
  <Schema
    item={{
      '@context': 'https://schema.org',
      '@graph': graph,
    }}
  />
)}
